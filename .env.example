# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_PATH=./aibooks.db

# Processing
MAX_WORKERS=4
BATCH_SIZE=10

# Cost Control
DAILY_COST_CAP=10.0
COST_WARNING_THRESHOLD=5.0

# LLM Configuration
DEFAULT_LLM_MODEL=gpt-4o-mini
METADATA_LLM_MODEL=gpt-4o-mini
CLEANUP_LLM_MODEL=gpt-4o-mini
AGENT_LLM_MODEL=gpt-4o

# Calibre
CALIBRE_PATH=/usr/bin/ebook-meta

# Docling
DOCLING_OCR_ENABLED=true
DOCLING_VISION_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/aibooks.log

# Output
OUTPUT_DIR=./output
TEMP_DIR=./data/temp
