# ==========================================
# LLM API Keys
# ==========================================
# Get keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Groq: https://console.groq.com/

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# ==========================================
# LLM Provider Selection
# ==========================================
# Choose which provider to use for different scenarios
# Options: openai, anthropic, ollama, groq

DEFAULT_PROVIDER=openai          # For standard tasks
ADVANCED_PROVIDER=openai         # For complex analysis
FREE_PROVIDER=ollama             # For simple tasks (local, free!)

# ==========================================
# LLM Models by Task
# ==========================================
# Recommended free models (Ollama - no API key needed):
#   - llama3.1:8b (general purpose, fast)
#   - mistral (good for technical tasks)
#   - phi3 (small, efficient)
#   - codellama (for code understanding)
#
# Recommended paid models:
#   OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
#   Anthropic: claude-3-5-sonnet, claude-3-opus, claude-3-haiku
#   Groq: llama-3.1-70b-versatile, mixtral-8x7b (cheap & fast!)

DEFAULT_LLM_MODEL=gpt-4o-mini
METADATA_LLM_MODEL=gpt-4o-mini
CLEANUP_LLM_MODEL=gpt-4o-mini
AGENT_LLM_MODEL=gpt-4o
ADVANCED_LLM_MODEL=gpt-4o

# ==========================================
# FREE Models (Ollama - Local)
# ==========================================
# Install Ollama: https://ollama.ai/
# Pull models: ollama pull llama3.1:8b
# Check available: ollama list

FREE_LLM_MODEL=llama3.1:8b
SIMPLE_TASK_MODEL=llama3.1:8b

# Ollama server configuration
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# LLM Strategy
# ==========================================
# Use free models for simple tasks to save costs
USE_FREE_FOR_SIMPLE=true
COST_THRESHOLD=0.01

# ==========================================
# Database
# ==========================================
DATABASE_PATH=./aibooks.db

# ==========================================
# Processing
# ==========================================
MAX_WORKERS=4
BATCH_SIZE=10

# ==========================================
# Cost Control
# ==========================================
DAILY_COST_CAP=10.0
COST_WARNING_THRESHOLD=5.0

# ==========================================
# Calibre
# ==========================================
CALIBRE_PATH=/usr/bin/ebook-meta

# ==========================================
# Docling
# ==========================================
DOCLING_OCR_ENABLED=true
DOCLING_VISION_ENABLED=true

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=logs/aibooks.log

# ==========================================
# Output
# ==========================================
OUTPUT_DIR=./output
TEMP_DIR=./data/temp
